# ============================================================
# Last Oasis dedicated server — user configuration
# Copy to `server.env` (or supply via compose `environment:`)
# and fill in your values. Overrides defaults.env.
# ============================================================

# --- REQUIRED ---

# Game server registration key
#   → myrealm.lastoasis.gg/Settings ("Game server registration key")
SERVER_CUSTOMER_KEY=""

# Self-hosted provider key
#   → myrealm.lastoasis.gg/Settings ("Self hosted game servers registration keys")
SERVER_PROVIDER_KEY=""

# Unique server name within the realm
SERVER_IDENTIFIER="oasis-01"

# Public IPv4 of the host (clients connect to this)
SERVER_IP_ADDRESS=""

# Game port (UDP+TCP). Must be unique per IP within the realm.
SERVER_PORT="62001"

# Steam A2S query port (UDP+TCP). Must be unique per IP within the realm.
SERVER_QUERY_PORT="27015"


# --- OPTIONAL ---

# Player slots (default: 10; recommend 25 for a small VPS; max 100)
SERVER_SLOTS="25"

# Additional Unreal Engine command-line flags, appended verbatim
# SERVER_OPTIONS="-log -NoEAC"

# Steam login.
#
# Per Donkey Crew's official guide: "If you own Last Oasis on Steam,
# you should also have access to the Last Oasis - Dedicated Server
# application." This means the installer app (920720) may NOT be
# anonymously downloadable — you may need a real Steam account that
# owns Last Oasis, in which case:
#   1. Set STEAM_USER to that account's username
#   2. Run `lo login` once interactively to cache the password + 2FA
#   3. Subsequent `lo install` runs will use the cached session
# Leave at "anonymous" first; switch only if install fails with
# "Invalid Password" or "Login Failure".
# STEAM_USER="anonymous"

# Override the in-volume game install path
# INSTALL_DIR="/data/last-oasis"

# Where backups land (on the persistent volume)
# BACKUP_DIR="/data/backups"

# Logging verbosity (`info` or `debug`)
# LO_LOG_LEVEL="info"
