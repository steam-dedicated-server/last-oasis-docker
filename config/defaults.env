# Default configuration values for `lo`.
# Override via config/server.env, an .env file, or container env vars.

# Install location for the dedicated server.
# Inside the Docker image: /mnt/steam is the persistent volume mount
# (upstream convention; matches existing K8s PVCs and the original
# Deradon image so volumes migrate cleanly).
INSTALL_DIR="${INSTALL_DIR:-/mnt/steam/last-oasis}"

# Steam App IDs (do not change unless Donkey Crew changes them):
#   STEAM_APP_ID       — installer app SteamCMD downloads
#                        (920720 = "Last Oasis - Dedicated Server")
#   STEAM_LINUX_APP_ID — runtime app id written into steam_appid.txt
#                        after install (903950 = "Last Oasis"), so
#                        MistServer identifies itself to Steam's
#                        matchmaking backend correctly.
# Mixing these up causes `Invalid platform` on app_update.
STEAM_APP_ID="${STEAM_APP_ID:-920720}"
STEAM_LINUX_APP_ID="${STEAM_LINUX_APP_ID:-903950}"

# Steam user: `anonymous` downloads without login (no 2FA needed).
STEAM_USER="${STEAM_USER:-anonymous}"

# Server defaults
SERVER_SLOTS="${SERVER_SLOTS:-10}"

# Retry behavior for steamcmd downloads.
# DOWNLOAD_MAX_ATTEMPTS is the upstream/K8s-facing name; LO_RETRY_MAX
# is the internal name used by lo::retry. Honoring the former lets
# existing K8s manifests pass the value through unchanged.
LO_RETRY_MAX="${LO_RETRY_MAX:-${DOWNLOAD_MAX_ATTEMPTS:-5}}"
LO_RETRY_DELAY="${LO_RETRY_DELAY:-2}"

# Backup defaults
BACKUP_DIR="${BACKUP_DIR:-/mnt/steam/backups}"

# Healthcheck (used by docker/healthcheck.py)
HEALTHCHECK_HOST="${HEALTHCHECK_HOST:-127.0.0.1}"
HEALTHCHECK_TIMEOUT="${HEALTHCHECK_TIMEOUT:-3}"
